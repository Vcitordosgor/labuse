#!/usr/bin/env bash
# CI-1 (Lot 4) — FILET LOCAL avant envoi. Installé par `bash scripts/ci/install-hooks.sh`
# (pose core.hooksPath=scripts/git-hooks). Objectif < 2 min : scan de secrets, front (tsc -b +
# vitest), tests unitaires Python (SANS base). Si une vérif échoue → PUSH REFUSÉ, message clair.
# URGENCE : `git push --no-verify` contourne ce filet (la CI GitHub re-vérifiera après l'envoi).
# Compatible bash 3.2 (Mac). N'a pas besoin de la base : la famille « unitaires » ne la touche pas.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

fail=0
step() { printf '\n▶ %s\n' "$1"; }

# 1) Secrets — rapide, échoue tôt.
step "Scan de secrets"
bash scripts/ci/scan_secrets.sh || fail=1

# 2) Front — tsc -b + vitest (pas de build : trop lent pour un pre-push).
if [ -d frontend/node_modules ]; then
  step "Front — tsc -b"
  ( cd frontend && npx tsc -b ) || fail=1
  step "Front — vitest"
  ( cd frontend && npx vitest run ) || fail=1
else
  printf '\n✗ frontend/node_modules absent → front NON vérifié. Lance `cd frontend && npm ci`,\n'
  printf '  ou `git push --no-verify` si tu ne touches pas au front.\n'
  fail=1
fi

# 3) Python — tests UNITAIRES (famille sans base : rapide, pas besoin de PostgreSQL).
# Trouve un Python QUI A pytest : .venv du worktree, puis .venv du dépôt principal (si on est dans
# un worktree lié), puis un python du PATH. Exiger pytest évite de tomber sur un python système nu.
common="$(git rev-parse --git-common-dir 2>/dev/null)"
PY=""
for cand in "$ROOT/.venv/bin/python" "${common%/.git}/.venv/bin/python" "$common/../.venv/bin/python" python3 python; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import pytest" >/dev/null 2>&1; then PY="$cand"; break; fi
done
step "Python — tests unitaires (sans base)"
if [ -z "$PY" ]; then
  printf '✗ aucun Python avec pytest trouvé (active le venv du dépôt : pip install -e ".[dev,ci]").\n'
  fail=1
else
  PYTHONPATH=src "$PY" -m pytest -m "not db and not local and not reel and not network" -q -p no:cacheprovider || fail=1
fi

# 4) COHÉRENCE (COHERENCE-HOOK-1) — la suite tourne QUAND la base locale répond ; sinon le hook l'écrit
# EN ROUGE, jamais en silence. Un écart (1 €/1 m²) entre fiche/outils/PDF/Docs/Copilote REFUSE le push.
# Base injoignable : ROUGE non bloquant par défaut (les sessions // peuvent pousser DB froide) — poser
# LABUSE_COHERENCE_HOOK=block pour refuser aussi dans ce cas. Le banc de nuit reste le filet dur.
step "Cohérence (12 témoins — base locale)"
bash scripts/ci/coherence_run.sh
coh_rc=$?
if [ "$coh_rc" -eq 1 ]; then
  fail=1                                   # écart RÉEL de cohérence → toujours bloquant
elif [ "$coh_rc" -eq 2 ]; then
  if [ "${LABUSE_COHERENCE_HOOK:-warn}" = "block" ]; then
    printf '  (LABUSE_COHERENCE_HOOK=block → base injoignable bloque le push.)\n'; fail=1
  else
    printf '  (base injoignable : AVERTISSEMENT rouge, push autorisé — LABUSE_COHERENCE_HOOK=block pour bloquer.)\n'
  fi
fi

if [ "$fail" -ne 0 ]; then
  printf '\n✗ PUSH REFUSÉ — une vérification a échoué (détail ci-dessus).\n'
  printf '  Corrige puis repousse. URGENCE réelle uniquement : git push --no-verify\n'
  printf '  (à réserver aux cas où le rouge est connu/sans rapport ET le temps presse —\n'
  printf '   la CI GitHub re-vérifiera de toute façon après l’envoi).\n'
  exit 1
fi
printf '\n✓ Vérifications OK — envoi autorisé.\n'
exit 0
