# CRON-1 (K1) / SOLIDITE-1 (Lot 1.1) — rotation des logs de jobs (un fichier par job dans
# /var/log/labuse/jobs). 12 MOIS d'historique mensuel, compressés. Posé par deploy.sh.
# Sous-dossier dédié : ne chevauche plus /etc/logrotate.d/labuse (logs applicatifs = /var/log/labuse/*.log).
/var/log/labuse/jobs/*.log {
    monthly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    su labuse labuse
    copytruncate
}
