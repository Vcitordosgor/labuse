# =============================================================================
# LA BUSE — Caddyfile de PRODUCTION (app.labuse.immo) — AUCUN secret ici.
# -----------------------------------------------------------------------------
# Pose sur le VPS : /etc/caddy/Caddyfile + /etc/caddy/labuse.env (600) portant :
#   LABUSE_DOMAIN=app.labuse.immo
#
# MANDAT VPS V5 (27/08/2026) : LE RIDEAU BASIC AUTH EST TOMBÉ — l'auth comptes
# applicative (argon2id + sessions en base + 2FA TOTP admin) est la porte. Ce
# fichier n'a plus ni basic_auth ni CADDY_BASIC_HASH. Défenses restantes ici :
#   · HSTS (le certificat est géré par Caddy, HTTP → HTTPS automatique) ;
#   · journal d'accès JSON → fail2ban (jail labuse-login : brute-force /login
#     banni au pare-feu — l'app a SON verrou de compte, ceci est la 2e couche) ;
#   · en-têtes durcis (les CSP fines viennent de l'APP — R4 — et passent telles
#     quelles : Caddy n'écrase pas les en-têtes du backend).
#
# Routage (hérité M7/B2, inchangé) :
#   · le dist React (build --base=/) est servi STATIQUEMENT à la racine ;
#   · /app et /app/* ne sont JAMAIS exposés (301 → /) — vieille UI = dev local ;
#   · une navigation `/` SANS cookie de session applicative → 302 /login ;
#   · tout le reste (API, tuiles, /login, PDF, webhook Stripe…) → 127.0.0.1:8000.
# =============================================================================

{$LABUSE_DOMAIN} {
	# G1 lot 3 — compression. `zstd gzip` : codecs du build standard (zstd > gzip, repli gzip
	# universel). Les TUILES VECTORIELLES sortent déjà en **brotli** depuis l'API (api/tiles pose
	# `Content-Encoding: br`) ; Caddy transmet tel quel (il ne ré-encode pas un corps déjà encodé),
	# donc brotli est actif bout-en-bout sur les tuiles SANS exiger le module brotli côté Caddy.
	# Pour forcer brotli AUSSI sur le reste du trafic, utiliser un build Caddy avec l'encodeur
	# brotli et écrire `encode zstd br gzip`.
	encode zstd gzip

	# ── journal d'accès (JSON) : matière de fail2ban (deploy/fail2ban/) et des
	# autopsies. Rotation par logrotate (/var/log/caddy géré par le paquet). ──
	log {
		output file /var/log/caddy/access.log
		format json
	}

	root * /opt/labuse/app/frontend/dist

	route {
		# 1. la vieille UI n'est jamais exposée (couvre aussi le 303 post-login → /app/)
		redir /app / 301
		redir /app/* / 301

		# 2. navigation racine sans session applicative → page de login (backend)
		@nosession {
			path /
			not header Cookie *labuse_session=*
		}
		redir @nosession /login 302

		# 3. le front : shell + assets du build servis statiquement
		@front {
			file {
				try_files {path} {path}/index.html
			}
		}
		file_server @front

		# 4. API / tuiles / login / PDF / webhook Stripe → backend
		# ETUDE-V6-2 (Lot 3) — l'Étude de faisabilité est bornée à 60 s côté app (_ETUDE_TIMEOUT_S).
		# CORRECTIFS-2 (Lot 2) — marge portée de 75 s à 90 s (30 s au-dessus de la borne) : la borne ne
		# couvre QUE le calcul ; l'EXPORT PDF (WeasyPrint, /modules/etude/pdf) rend APRÈS, si bien qu'une
		# assiette lourde de 4 parcelles à froid dépassait 75 s et récoltait un 504 transitoire. (Aligne nginx.)
		reverse_proxy 127.0.0.1:8000 {
			transport http {
				read_timeout 90s
			}
		}
	}

	header {
		# V5 — HSTS : 6 mois, sous-domaine seul (pas de preload : app.labuse.immo
		# est le seul hôte servi ici, labuse.immo nu n'est pas notre affaire).
		Strict-Transport-Security "max-age=15552000"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# ── cache navigateur — /assets/* portent un hash de contenu (vite) : immuables.
	# JAMAIS sur index.html (le shell doit se revalider pour pointer les nouveaux hashes).
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell path / /index.html
	header @shell Cache-Control "no-cache"
}
