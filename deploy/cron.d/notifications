# LA BUSE — LE CENTRE DE NOTIFICATIONS (M85). Le digest quotidien part à 7h00 HEURE RÉUNION.
# Le VPS tourne en UTC : 03:00 UTC = 07:00 à La Réunion (UTC+4, pas d'heure d'été). Le fuseau est
# AUSSI explicite dans le code (events.REUNION_TZ = UTC+4) — le cron et le code s'accordent, aucun
# n'hérite du fuseau machine.
# M98 : horaire INCHANGÉ — mais les ingestions quotidiennes passent désormais AVANT (sitadel
# 02:15, bodacc 02:30) : le digest voit les données de la nuit, plus celles de l'avant-veille.
#
# Chaîne quotidienne, dans l'ordre : évaluer les suivis de parcelle → évaluer les veilles Copilote
# (nouvelles données → notifications) → signaler les décrochages de fraîcheur (source en retard →
# notif systeme pilote) → purger les notifications de plus de 90 j → envoyer le digest e-mail
# (filtré par préférence, digest vide ne part pas, désinscription + préférences dans chaque
# e-mail). Chaque geste est idempotent et journalisé.
# Verrou flock (-E 200 = tour sauté, jamais confondu avec un échec du job) ; saut journalisé.
#
# Installation VPS :  install -o root -g root -m 644 deploy/cron.d/notifications /etc/cron.d/notifications
SHELL=/bin/sh
0 3 * * * labuse flock -n -E 200 /run/lock/labuse-notifications.lock -c "set -a; . /etc/labuse/labuse.env; set +a; cd /opt/labuse/app && /opt/labuse/venv/bin/labuse evaluer-suivis >> /var/log/labuse/notifications.log 2>&1 && /opt/labuse/venv/bin/labuse evaluer-veilles >> /var/log/labuse/notifications.log 2>&1 && /opt/labuse/venv/bin/labuse notifier-fraicheur >> /var/log/labuse/notifications.log 2>&1 && /opt/labuse/venv/bin/labuse purge-notifications >> /var/log/labuse/notifications.log 2>&1 && /opt/labuse/venv/bin/labuse digest --freq quotidien >> /var/log/labuse/notifications.log 2>&1"; test $? -eq 200 && echo "$(date -u +\%FT\%TZ) notifications : passage sauté : exécution précédente en cours" >> /var/log/labuse/notifications.log
