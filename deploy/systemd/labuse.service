# =============================================================================
# LA BUSE — service systemd (FastAPI/Uvicorn derrière CADDY — mandat VPS V4)
# -----------------------------------------------------------------------------
# Pose (NE PAS appliquer maintenant — voir docs/DEPLOYMENT_OVH_VPS.md §8) :
#   install -o root -g root -m 644 deploy/systemd/labuse.service /etc/systemd/system/labuse.service
#   systemctl daemon-reload && systemctl enable --now labuse
#   journalctl -u labuse -f          # logs (journald — JAMAIS de nohup)
# =============================================================================
[Unit]
Description=LA BUSE — radar foncier (Uvicorn)
Documentation=file:/opt/labuse/app/docs/DEPLOYMENT_OVH_VPS.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=labuse
Group=labuse
WorkingDirectory=/opt/labuse/app

# Secrets & configuration (LABUSE_* + ANTHROPIC_API_KEY) — hors du dépôt git.
EnvironmentFile=/etc/labuse/labuse.env

# AUTONOMIE-2 — le heal de schéma ne tourne PLUS dans les workers pendant le service. Les workers le
# SAUTENT (LABUSE_SKIP_BOOT_HEAL=1) ; il est joué EN SÉRIE, AVANT l'ouverture du port, par l'ExecStartPre
# ci-dessous. Sur `systemctl restart`, l'ancien service est DÉJÀ arrêté quand l'ExecStartPre tourne →
# aucune écriture `event_log` concurrente → plus de `lock_timeout` sur l'`ALTER event_log …` → fin de la
# récurrence `/readyz` 503 (DEPLOY-1028b / DEPLOY-FINAL / DEPLOY-AUTONOMIE).
Environment=LABUSE_SKIP_BOOT_HEAL=1

# Heal PRÉ-SERVICE (en série, hors trafic). Échec → `ExecStartPre` échoue → le service NE démarre PAS :
# un heal raté est BRUYANT (unit en failed + alerte), jamais un /readyz 503 silencieux sur un worker.
ExecStartPre=/opt/labuse/venv/bin/labuse schema-heal

# Uvicorn, 5 workers (mandat VPS V4 : 6 vCores, 12 Go — marge laissée à PostgreSQL).
# --proxy-headers : on est derrière Caddy ; --forwarded-allow-ips limite la confiance au proxy local.
ExecStart=/opt/labuse/venv/bin/uvicorn labuse.api.app:app \
    --host 127.0.0.1 --port 8000 \
    --workers 5 \
    --timeout-keep-alive 75 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1

# Redémarrage automatique QUOI QU'IL ARRIVE (mandat VPS V4 : le dashboard a déjà tué
# l'uvicorn local 2 fois — jamais de service mort silencieux, même sur exit 0 anormal).
Restart=always
RestartSec=3
# AUTONOMIE-2 — couvre le heal PRÉ-SERVICE (ExecStartPre `labuse schema-heal` : ensure_schema + 18
# steps + VALIDATE des FK commune, qui scanne de grosses tables) EN PLUS du boot uvicorn. 60 s était
# juste pour le seul uvicorn ; 180 s laisse la marge au heal sérialisé (mesuré « quelques s » hors charge).
TimeoutStartSec=180
# Garde-fou mémoire : 5 workers × ~700 Mo max + marge ; au-delà, l'OOM killer systemd
# redémarre le service PLUTÔT que de laisser le noyau tuer PostgreSQL.
MemoryMax=6G

# Logs → journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=labuse

# Durcissement raisonnable (l'app n'écrit rien hors /opt/labuse et /tmp privé).
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
