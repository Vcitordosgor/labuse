{"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [{"kind": "inspire"}, {"kind": "hvd"}], "contact_points": [{"contact_form": null, "email": "contact.geoservices@ign.fr", "id": "693766e40139d2f8f2517e92", "name": "INSTITUT NATIONAL DE L'INFORMATION GEOGRAPHIQUE ET FORESTIERE (IGN)", "organization": {"acronym": "IGN", "badges": [{"kind": "public-service"}, {"kind": "certified"}], "class": "Organization", "id": "534fff80a3a7292c64a77e41", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/81/98295ded66449e80a960b8bc20e527.jpg", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/81/98295ded66449e80a960b8bc20e527-100.jpg", "name": "Institut national de l'information g\u00e9ographique et foresti\u00e8re", "page": "https://www.data.gouv.fr/organizations/institut-national-de-linformation-geographique-et-forestiere", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "institut-national-de-linformation-geographique-et-forestiere", "uri": "https://www.data.gouv.fr/api/1/organizations/institut-national-de-linformation-geographique-et-forestiere/"}, "owner": null, "role": "contact"}], "created_at": "2025-09-01T00:00:00+00:00", "deleted": null, "description": "Le produit Parcellaire Express (PCI) contient les informations relatives au parcellaire cadastral. \n\nIl s\u2019agit d\u2019une base de donn\u00e9es bidimensionnelle. \n\nLe produit Parcellaire Express (PCI) ne se substitue pas au plan cadastral d\u00e9mat\u00e9rialis\u00e9. C'est un assemblage de ce plan sur le territoire national couvert par le cadastre, qui utilise les fichiers PCI Vecteur de la DGFiP. \n\nLe PCI de la DGFiP tend \u00e0 devenir PCI Vecteur sur tout le territoire. \n\nLe produit Parcellaire Express (PCI) est constitu\u00e9 d\u2019objets g\u00e9ographiques simples (objets vecteurs ponctuels, surfaciques ou multi-surfaciques)et d'une table attributaire.\n\nCette donn\u00e9e n\u2019a pas fait l\u2019objet de corrections g\u00e9om\u00e9triques. Un d\u00e9calage par rapport \u00e0 d\u2019autres donn\u00e9es (photographies a\u00e9riennes en particulier) peut appara\u00eetre.", "description_short": null, "doi": null, "extras": {"dcat": {"accessRights": ["http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/noLimitations"], "license": ["https://www.etalab.gouv.fr/wp-content/uploads/2018/11/open-licence.pdf"], "provenance": ["Les donn\u00e9es cadastrales proviennent du plan cadastral informatis\u00e9 en mode vecteur (PCI Vecteur) fourni par la DGFiP. \n\t\t\t\t  \n\t\t\t\t   Derni\u00e8re mise \u00e0 jour : T\u00e9l\u00e9chargement et flux - Edition Juin 2026"], "spatial_resolution": "1/15000"}}, "featured": false, "frequency": "quarterly", "frequency_date": null, "geopf": null, "harvest": {"backend": "CSW-ISO-19139", "dct_identifier": "IGNF_PARCELLAIRE-EXPRESS-PCI", "domain": "data.geopf.fr", "issued_at": "2025-09-01T00:00:00+00:00", "last_update": "2026-10-16T00:01:34.088000+00:00", "modified_at": "2026-09-09T00:00:00+00:00", "remote_id": "IGNF_PARCELLAIRE-EXPRESS-PCI", "remote_url": "https://cartes.gouv.fr/catalogue/dataset/IGNF_PARCELLAIRE-EXPRESS-PCI", "source_id": "6661be94ab84a66e528ae72e", "source_url": "https://data.geopf.fr/csw/ressources_o"}, "id": "61489f2f2de14040f348fa0b", "internal": {"created_at_internal": "2021-09-20T16:48:15.460000+00:00", "last_modified_internal": "2024-12-09T16:11:27.801000+00:00"}, "last_modified": "2026-09-09T00:00:00+00:00", "last_update": "2026-09-09T00:00:00+00:00", "license": "lov2", "metrics": {"dataservices": 1, "discussions": 1, "discussions_open": 0, "followers": 1, "followers_by_months": {"2024-08": 0, "2024-09": 0, "2024-10": 0, "2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0}, "resources_downloads":