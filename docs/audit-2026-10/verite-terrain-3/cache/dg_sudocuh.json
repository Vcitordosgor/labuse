"check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "geopf": null, "harvest": null, "id": "1e86edf0-f18c-424a-b06c-071ec2175d9b", "internal": {"created_at_internal": "2022-03-30T14:35:55.624000+00:00", "last_modified_internal": "2024-02-12T10:47:31.655000+00:00"}, "last_modified": "2025-04-21T01:52:30.445011+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/1e86edf0-f18c-424a-b06c-071ec2175d9b", "metrics": {"views": 845}, "mime": null, "preview_url": null, "schema": {"name": null, "url": null, "version": null}, "title": "API - SuDocUH - R\u00e9sultats Enqu\u00eates urbanisme depuis 2013", "type": "api", "url": "https://api-sudocuh.datahub.din.developpement-durable.gouv.fr/docs"}, {"checksum": null, "created_at": "2022-03-30T15:19:44.246000+00:00", "description": "Les EPCI de SuDocUH sont mises \u00e0 jour par les services d\u00e9concentr\u00e9s (p\u00e9rim\u00e8tre communal et comp\u00e9tences PLU, SCoT et PLH). Les donn\u00e9es publi\u00e9es sont arr\u00eat\u00e9es au 31/12/2021 et au COG 2021.", "extras": {"analysis:check_id": 55194153, "analysis:checksum": "4130803b72e5827d22da4a4fb437486d4e6e3295", "analysis:content-length": 166090, "analysis:last-modified-at": "2026-10-16T05:33:21.397732+00:00", "analysis:last-modified-detection": "computed-checksum", "analysis:mime-type": "text/html", "check:available": true, "check:cors:allow-headers": "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range", "check:cors:allow-methods": "GET, POST, OPTIONS", "check:cors:allow-origin": "*", "check:cors:max-age": "1728000", "check:cors:status": 204, "check:date": "2026-08-07T16:07:49.060388+00:00", "check:headers:content-type": "text/html", "check:id": 51279426, "check:status": 200, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "geopf": null, "harvest": null, "id": "6e2de3b7-f03b-4fe2-aef5-18d1782472e7", "internal": {"created_at_internal": "2022-03-30T15:19:44.246000+00:00", "last_modified_internal": "2022-03-30T15:19:44.246000+00:00"}, "last_modified": "2026-10-16T05:33:21.397732+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/6e2de3b7-f03b-4fe2-aef5-18d1782472e7", "metrics": {"views": 587}, "mime": null, "preview_url": null, "schema": {"name": null, "url": null, "version": null}, "title": "Autres donn\u00e9es SuDocUH - Liste des \u00c9tablissement public de coop\u00e9ration intercommunale (EPCI)", "type": "other", "url": "https://www.data.gouv.fr/fr/datasets/liste-des-etablissement-public-de-cooperation-intercommunale-epci-issue-de-lenquete-urbanisme-sudocuh-au-31-12-2021/"}, {"checksum": null, "created_at": "2022-03-30T15:05:46.626000+00:00", "description": "Ce jeu de donn\u00e9es d\u00e9crit, par SCOT, les proc\u00e9dures en \u00e9laboration ou r\u00e9vision du SCOT en cours et celles qui sont approuv\u00e9es.\nLes donn\u00e9es \u00e9l\u00e9mentaires de l\u2019ann\u00e9e N sont produites par les directions d\u00e9partementales des territoires en janvier N+1 et arr\u00eat\u00e9es au 31 d\u00e9cembre N (ici 2021). Le jeu de donn\u00e9es mill\u00e9sim\u00e9 est produit habituellement en mars apr\u00e8s un processus de v\u00e9rification notamment de leur compl\u00e9tude, de leur coh\u00e9rence par rapport au COG de l\u2019ann\u00e9e. Des inexactitudes tr\u00e8s ponctuelles restent toutefois possibles.\n\nLa loi sur la solidarit\u00e9 et le renouvellement urbain (loi SRU) du 13/12/2000 pr\u00e9voit la mise en place, \u00e0 partir du 1er janvier 2002 des sch\u00e9mas de coh\u00e9rence territoriale, qui remplacent les sch\u00e9mas directeurs. \u00c9labor\u00e9s par les \u00e9lus, \u00e0 l\u2019\u00e9chelle du bassin de vie, d\u2019habitat ou d\u2019emploi, ils auront pour vocation d\u2019exprimer la strat\u00e9gie globale de l\u2019agglom\u00e9ration et d\u2019\u00e9noncer les choix principaux en mati\u00e8re d\u2019habitat, d\u2019\u00e9quilibre entre zones naturelles et urbaines, d\u2019infrastructures, d\u2019urbanisme commercial. Dans les zones p\u00e9ri-urbaines, au cas o\u00f9 le SCOT n\u2019existe pas, toute zone d\u2019urbanisation sera bloqu\u00e9e, sauf accord du pr\u00e9fet, dans un rayon de 15 km autour des communes de l\u2019agglom\u00e9ration si celle-ci compte plus de 15 000 habitants.", "extras": {"analysis:check_id": 55183559, "analysis:checksum": "86aabf63cec94f27037d491735fb090ae006b2e0", "analysis:content-length": 215059, "analysis:last-modified-at": "2026-10-16T02:02:45.730022+00:00", "analysis:last-modified-detection": "computed-checksum", "analysis:mime-type": "text/html", "check:available": true, "check:cors:allow-headers": "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range", "check:cors:allow-methods": "GET, POST, OPTIONS", "check:cors:allow-origin": "*", "check:cors:max-age": "1728000", "check:cors:status": 204, "check:date": "2026-09-30T00:17:13.684697+00:00", "check:headers:content-type": "text/html", "check:id": 54222834, "check:status": 200, "check:timeout": false}, "filesize": null, "filetype": "remote", "format": "url", "geopf": null, "harvest": null, "id": "62bd4eca-3bcc-47ae-8e05-355fee7eafd1", "internal": {"created_at_internal": "2022-03-30T15:05:46.626000+00:00", "last_modified_internal": "2022-03-30T15:05:46.626000+00:00"}, "last_modified": "2026-10-16T02:02:45.730022+00:00", "latest": "https://www.data.gouv.fr/api/1/datasets/r/62bd4eca-3bcc-47ae-8e05-355fee7eafd1", "metrics": {"views": 1235}, "mime": null, "preview_url": null, "schema": {"name": null, "url": null, "version": null}, "title": "Autres donn\u00e9es SuDocUH - Sch\u00e9ma de coh\u00e9rence territoriale (SCoT) ", "type": "other", "url": "https://www.data.gouv.fr/fr/datasets/schema-de-coherence-territoriale-scot-donnees-sudocuh-dernier-etat-des-lieux-annuel-au-31-decembre-2021/"}, {"checksum": {"type": "sha1", "value": "b4f411d74597431de20aeb6c185bc5db00fdd5be"}, "created_at": "2022-03-24T11:09:39.197000+00:00", "description": "\n\n- 2020-DGALN-BCSI-OPENDATA