{"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [{"contact_form": "http://www.loiret.gouv.fr/", "email": "ddt-pcpt-suadt@loiret.gouv.fr", "id": "6a83c0346eb89eb6c1322319", "name": "DDT 45 (Direction D\u00e9partementale des Territoires du Loiret)", "organization": {"acronym": "DDT 45", "badges": [{"kind": "certified"}, {"kind": "public-service"}], "class": "Organization", "id": "55b0f23788ee3838d73ca289", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/2015-07-23/0b8062c37c1b499e8d7f12155ba0e950/logo_DDT.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/2015-07-23/0b8062c37c1b499e8d7f12155ba0e950/logo_DDT-100.png", "name": "Direction D\u00e9partementale des Territoires du Loiret", "page": "https://www.data.gouv.fr/organizations/direction-departementale-des-territoires-du-loiret", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "direction-departementale-des-territoires-du-loiret", "uri": "https://www.data.gouv.fr/api/1/organizations/direction-departementale-des-territoires-du-loiret/"}, "owner": null, "role": "contact"}], "created_at": "2023-04-19T00:00:00+00:00", "deleted": null, "description": "Extraction sur le d\u00e9partement du Loiret des donn\u00e9es opendata cartofriche diffus\u00e9es par le CEREMA.", "description_short": null, "doi": null, "extras": {"dcat": {"accessRights": ["Pas de restriction d'acc\u00e8s public selon INSPIRE"], "license": ["Licence Ouverte / Open Licence Version 2.0 https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf", "Aucun des articles de la loi ne peut \u00eatre invoqu\u00e9 pour justifier d'une restriction d'acc\u00e8s public."], "provenance": ["Le besoin principal auquel souhaite r\u00e9pondre Cartofriches est l'aide au recensement des friches pour les qualifier et faciliter leur r\u00e9utilisation. Il s'adresse \u00e0 tout porteur de projet, public ou priv\u00e9.\n\nLe Cerema utilise les donn\u00e9es de BASIAS et BASOL, ainsi que d'autres lots de donn\u00e9es nationaux (candidatures aux appels \u00e0 projets, par exemple) pour assurer une pr\u00e9-identification des friches sur tout le territoire national.\n\nCartofriches a vocation \u00e0 consolider ce recensement avec la participation des acteurs locaux au plus pr\u00e8s du terrain.\n\nC'est en int\u00e9grant les donn\u00e9es des observatoires locaux et des \u00e9tudes de recensement port\u00e9es par des acteurs de l\u2019am\u00e9nagement que l'inventaire national pourra \u00eatre le plus pertinent et mis \u00e0 jour."], "rights": ["Licence Ouverte / Open Licence Version 2.0 https://www.etalab.gouv.fr/wp-content/uploads/2017/04/ETALAB-Licence-Ouverte-v2.0.pdf", "Aucun des articles de la loi ne peut \u00eatre invoqu\u00e9 pour justifier d'une restriction d'acc\u00e8s public.", "Pas de restriction d'acc\u00e8s public selon INSPIRE"], "spatial_resolution": "1/5000"}}, "featured": false, "frequency": "unknown", "frequency_date": null, "geopf": null, "harvest": {"backend": "CSW-ISO-19139", "dct_identifier": "http://catalogue.geo-ide.developpement-durable.gouv.fr/8fb839c8-758d-497f-9e77-62f6db98992f", "domain": "ogc.geo-ide.developpement-durable.gouv.fr", "issued_at": "2023-04-19T00:00:00+00:00", "last_update": "2026-10-16T02:19:33.640000+00:00", "modified_at": "2023-04-14T00:00:00+00:00", "remote_id": "http://catalogue.geo-ide.developpement-durable.gouv.fr/8fb839c8-758d-497f-9e77-62f6db98992f", "remote_url": "http://catalogue.geo-ide.developpement-durable.gouv.fr/catalogue/srv/fre/catalog.search#/metadata/fr-120066022-jdd-397350f0-b1c5-42b4-b7cc-3818a5971f2b", "source_id": "67377ab4ec7f6f98eb21c7ca", "source_url": "https://ogc.geo-ide.developpement-durable.gouv.fr/csw/csw-ddt45", "uri": "http://catalogue.geo-ide.developpement-durable.gouv.fr/8fb839c8-758d-497