me":"content-length","value":"6142"},{"name":"content-security-policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://data.geopf.fr https://s3.amazonaws.com; connect-src 'self' https://data.geopf.fr https://s3.amazonaws.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"},{"name":"content-type","value":"application/json"},{"name":"date","value":"Fri, 25 Sep 2026 13:24:12 GMT"},{"name":"referrer-policy","value":"same-origin"},{"name":"server","value":"uvicorn"},{"name":"vary","value":"Accept-Encoding"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"DENY"}],"content":{"size":69898,"mimeType":"application/json","compression":63756,"text":"{\"unread\":254,\"items\":[{\"id\":9457,\"date\":\"2026-09-25\",\"ts\":\"2026-09-25 16:49:41.894906+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Un e-mail n'est pas parti (Courrier)\",\"detail\":\"Destinataire LABUSE <contact@labuse.immo> — « [LABUSE] Un client demande l'envoi de 1 courrier (Saint-Paul ×1) ». Cause : error: SSLCertVerificationError. Aucun renvoi automatique.\",\"demo\":false,\"source\":\"E-mail\",\"lien\":null,\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":9456,\"date\":\"2026-09-25\",\"ts\":\"2026-09-25 16:49:41.587861+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Un client demande l'envoi de 1 courrier (Saint-Paul ×1)\",\"detail\":\"Objet : Votre parcelle CV 441, à Saint-Paul\\n\\nCe courrier est destiné au propriétaire de la parcelle CV 441. Si vous n'en êtes pas le propriétaire, nous vous remercions de bien vouloir le lui transmettre.\\n\\nMadame, Monsieur,\\n\\nLABUSE est une plateforme d'intelligence foncière spécia\",\"demo\":false,\"source\":\"Courrier\",\"lien\":\"/courrier/admin\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":9455,\"date\":\"2026-09-24\",\"ts\":\"2026-09-24 18:33:37.522436+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"1 source a une nouvelle version\",\"detail\":\"• Annuaire de l'administration (service-public.fr / DILA) : la donnée amont a changé — à vérifier.\\nGeste supervisé : ouvrez la page Sources et cliquez « Injecter cette version » sur la source voulue — rien n'entre sans ce clic (la sentinelle n'ingère jamais).\",\"demo\":false,\"source\":\"Veille sources\",\"lien\":\"/sources\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":9454,\"date\":\"2026-09-22\",\"ts\":\"2026-09-22 21:19:47.600255+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Sonde du circuit : 1 fuite(s) ouverte(s), 0 eau(x) ancienne(s)\",\"detail\":\"Détail dans circuit_ecarts / circuit_eau_ancienne (page Circuit).\",\"demo\":false,\"source\":\"Circuit\",\"lien\":\"/admin\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":9453,\"date\":\"2026-09-22\",\"ts\":\"2026-09-22 21:19:47.600255+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Verrous cassés : V1c, G8\",\"detail\":\"Le déploiement refusera tant que ça tient. Détail : labuse circuit verrous.\",\"demo\":false,\"source\":\"Circuit\",\"lien\":\"/admin\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":9452,\"date\":\"2026-09-22\",\"ts\":\"2026-09-22 20:52:53.138834+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Donnée manuelle non rafraîchie : Radar (pige d'annonces) (depuis 13 j)\",\"detail\":\"« Radar (pige d'annonces) » est une donnée saisie à la main (aucun amont public à surveiller). Cadence de rafraîchissement attendue : 7 j — dernière ingestion il y a 13 j. À rafraîchir. La sentinelle ne sonde PAS cette source : ceci est un rappel, pas une alerte amont.\",\"demo\":false,\"source\":\"Veille sources\",\"lien\":\"/sources\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":9451,\"date\":\"2026-09-22\",\"ts\":\"2026-09-22 20:52:53.138834+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"2 sondes échouent depuis 3 passages\",\"detail\":\"Sondes en échec persistant (la sentinelle a échoué, PAS la donnée) :\\n• Géorisques — secteurs d'information sur les sols (SIS) : URLError: <urlopen error [SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: unable to get local issuer certificate (_ssl.c:1010)>\\n• OCS GE (IGN) — occupation du sol et artificialisation : URLError: <urlopen error [SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed: self-signed certificate in certificate chain (_ssl.c:1010)>\",\"demo\":false,\"source\":\"Veille sources\",\"lien\":\"/sources\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":5376,\"date\":\"2026-09-21\",\"ts\":\"2026-09-21 18:17:23.096372+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Opposition enregistrée (stop@) : 97401000AC0433\",\"detail\":\"AC 433\",\"demo\":false,\"source\":\"Courrier\",\"lien\":null,\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":5375,\"date\":\"2026-09-09\",\"ts\":\"2026-09-09 17:11:46.008669+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Demande n°45 passée à « Déposé »\",\"detail\":\"1 courrier(s) · Saint-Denis ×1\",\"demo\":false,\"source\":\"Courrier\",\"lien\":null,\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":5374,\"date\":\"2026-09-09\",\"ts\":\"2026-09-09 16:52:57.938895+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"1 sonde échoue depuis 3 passages\",\"detail\":\"Sondes en échec persistant (la sentinelle a échoué, PAS la donnée) :\\n• DEAL Réunion (WMS/WFS) : HTTPError: HTTP Error 404: NOT FOUND\",\"demo\":false,\"source\":\"Veille sources\",\"lien\":\"/sources\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":5373,\"date\":\"2026-09-09\",\"ts\":\"2026-09-09 14:55:41.28032+04\",\"kind\":\"pige.depot_html\",\"idu\":null,\"titre\":\"Dépôt Radar HTML — 35 annonces [riche (variante A)]\",\"detail\":\"0 nouvelles, 35 MAJ, 2 à qualifier\",\"demo\":false,\"source\":\"Radar\",\"lien\":null,\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":5372,\"date\":\"2026-09-09\",\"ts\":\"2026-09-09 14:53:13.736397+04\",\"kind\":\"pige.depot_html\",\"idu\":null,\"titre\":\"Dépôt Radar HTML — 35 annonces [riche (variante A)]\",\"detail\":\"0 nouvelles, 35 MAJ, 2 à qualifier\",\"demo\":false,\"source\":\"Radar\",\"lien\":null,\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":5371,\"date\":\"2026-09-08\",\"ts\":\"2026-09-08 23:27:10.92737+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Un client demande l'envoi de 1 courrier (Saint-Denis ×1)\",\"detail\":\"Objet : votre parcelle {parcelle}, à {commune}\\n\\nMadame, Monsieur,\\n\\nVotre parcelle cadastrée {parcelle} ({surface}), située à {commune}, présente à notre analyse un réel potentiel. Nous accompagnons des porteurs de projets locaux et serions heureux d'échanger avec vous, sans aucun\",\"demo\":false,\"source\":\"Courrier\",\"lien\":\"/courrier/admin\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":5370,\"date\":\"2026-09-08\",\"ts\":\"2026-09-08 18:33:31.372176+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Un client demande l'envoi de 1 courrier (Saint-Denis ×1)\",\"detail\":\"Objet : votre parcelle {parcelle}, à {commune}\\n\\nMadame, Monsieur,\\n\\nVotre parcelle cadastrée {parcelle} ({surface}), située à {commune}, présente à notre analyse un réel potentiel. Nous accompagnons des porteurs de projets locaux et serions heureux d'échanger avec vous, sans aucun\",\"demo\":false,\"source\":\"Courrier\",\"lien\":\"/courrier/admin\",\"commune\":null,\"lu\":false,\"statut\":null},{\"id\":5369,\"date\":\"2026-09-05\",\"ts\":\"2026-09-05 21:42:35.372524+04\",\"kind\":\"systeme\",\"idu\":null,\"titre\":\"Bascule de run : q_v11_m137 → q_v12\",\"detail\":\"Caches purgés : config (yaml/settings/rules_version), rnu (_entries), projets (_COMPTEUR_CACHE), banquier (_PDF_CACHE), accueil (chiffres/contexte/fraîcheur), protection (_gels_cache), tuiles carte (LRU), flux (_ECART_CACHE), zone_isochrone_cache (0 entrées). Cohérence : à vérifier. Effective immédiatement (served_run.txt relu à la requête)