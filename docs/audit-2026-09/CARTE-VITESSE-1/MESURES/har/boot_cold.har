t\",\"famille\":\"dispositifs\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":4,\"style\":{\"couleur\":\"#12A6B4\",\"opacite\":0.4,\"trait\":\"#0A6B75\"},\"niveaux\":null,\"popup\":null,\"legende\":\"TVA réduite 5,5 % (buffer 500 m des QPV)\",\"i\":\"Périmètre de TVA à taux réduit (5,5 %) pour l'accession sociale — buffer 500 m DÉRIVÉ des QPV (ANRU / quartiers prioritaires).\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":null,\"tuiles_url\":\"/map/tiles/tva_primo/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"qpv\",\"nom\":\"Quartiers prioritaires (QPV)\",\"famille\":\"dispositifs\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":5,\"style\":{\"couleur\":\"#E8934A\",\"opacite\":0.28,\"trait\":\"#E8934A\"},\"niveaux\":null,\"popup\":null,\"legende\":\"Quartier prioritaire de la Ville (QPV 2024)\",\"i\":\"Quartiers Prioritaires de la politique de la Ville (2024) — abattement TFPB, exonérations, priorités de rénovation.\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":null,\"tuiles_url\":\"/map/tiles/qpv/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"anru\",\"nom\":\"Rénovation urbaine (ANRU / NPNRU)\",\"famille\":\"dispositifs\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":6,\"style\":{\"couleur\":\"#C6E82E\",\"opacite\":0.3,\"trait\":\"#C6E82E\"},\"niveaux\":null,\"popup\":null,\"legende\":\"Périmètre ANRU / NPNRU (rénovation urbaine)\",\"i\":\"Périmètres NPNRU / ANRU (nouveau programme national de renouvellement urbain) — quartiers en rénovation.\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":null,\"tuiles_url\":\"/map/tiles/anru/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"parc_national\",\"nom\":\"Parc national\",\"famille\":\"environnement\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":8,\"style\":{\"trait\":\"#14532d\",\"epaisseur\":1.2},\"niveaux\":[{\"id\":\"coeur\",\"propriete\":\"subtype\",\"valeur\":\"coeur\",\"couleur\":\"#1E7A45\",\"opacite\":0.36,\"legende\":\"Cœur — inconstructible (~40 % de l'île)\"},{\"id\":\"adhesion\",\"propriete\":\"subtype\",\"valeur\":\"adhesion\",\"couleur\":\"#D9973B\",\"opacite\":0.2,\"legende\":\"Aire d'adhésion — réglementée, constructible\"}],\"popup\":null,\"legende\":\"Parc national — cœur (vert) / aire d'adhésion (ambre)\",\"i\":\"Périmètre du Parc national de La Réunion. Deux assiettes : le CŒUR (~40 % de l'île, inconstructible) et l'AIRE D'ADHÉSION (réglementée mais constructible). Urbanisation très restreinte.\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":\"opposable\",\"tuiles_url\":\"/map/tiles/parc_national/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"bassin_versant\",\"nom\":\"Bassins versants (hydrographie)\",\"famille\":\"environnement\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":10,\"style\":{\"contour_seul\":true,\"couleur\":\"#5FB0DE\",\"opacite\":0.8,\"trait\":\"#5FB0DE\",\"epaisseur\":1.4},\"niveaux\":null,\"popup\":null,\"legende\":\"Bassin versant — limites (trait)\",\"i\":\"Territoire de drainage — bassins versants (BD Carthage / hydrographie). Rien à voir avec les ouvrages (barrages).\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":null,\"tuiles_url\":\"/map/tiles/bassin_versant/{z}/{x}/{y}.pbf\",\"subdivise\":false},{\"kind\":\"znieff\",\"nom\":\"ZNIEFF (type I & II)\",\"famille\":\"environnement\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":12,\"style\":{\"couleur\":\"#8F9E4B\",\"trait\":\"#5f6b32\",\"epaisseur\":0.8},\"niveaux\":[{\"id\":\"type I\",\"propriete\":\"subtype\",\"valeur\":\"type I\",\"couleur\":\"#8F9E4B\",\"opacite\":0.34,\"legende\":\"Type I — secteur sensible (fort intérêt)\"},{\"id\":\"type II\",\"propriete\":\"subtype\",\"valeur\":\"type II\",\"couleur\":\"#3FA6A0\",\"opacite\":0.24,\"legende\":\"Type II — grand ensemble naturel\"}],\"popup\":[{\"champ\":\"id_mnhn\",\"libelle\":\"Numéro national\"},{\"champ\":\"type\",\"libelle\":\"Type\"},{\"champ\":\"gestionnaire\",\"libelle\":\"Gestionnaire\"},{\"champ\":\"url_fiche\",\"libelle\":\"Fiche INPN\",\"lien\":true}],\"legende\":\"ZNIEFF — type I (olive) / type II (sarcelle)\",\"i\":\"Inventaire du patrimoine naturel (INPN/MNHN PatriNat, maj 2025). Type I : secteur de fort intérêt biologique, plus restreint et sensible ; type II : grand ensemble naturel peu modifié. PAS une interdiction — un signal fort (étude d'impact renforcée, recours plus probable). ZNIEFF marines non affichées.\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":null,\"tuiles_url\":\"/map/tiles/znieff/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"enp\",\"nom\":\"Espaces naturels protégés\",\"famille\":\"environnement\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":14,\"style\":{\"couleur\":\"#6A4CC2\",\"opacite\":0.28,\"trait\":\"#6A4CC2\"},\"niveaux\":null,\"popup\":[{\"champ\":\"type\",\"libelle\":\"Type\"},{\"champ\":\"surface_ha\",\"libelle\":\"Surface (ha)\"}],\"legende\":\"Espace naturel protégé (réglementaire)\",\"i\":\"ENP par type (réserves naturelles dont marine, APB, conservatoire du littoral, réserves biologiques, Ramsar, sites classés/inscrits) — INPN + compléments DEAL Carmen. Protection réglementaire, souvent rédhibitoire.\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":\"opposable\",\"tuiles_url\":\"/map/tiles/enp/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"z