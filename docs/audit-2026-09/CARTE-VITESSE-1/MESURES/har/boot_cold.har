 solid var(--line);border-radius:8px;background:var(--panel);margin-bottom:8px;position:relative}\n.cxp .node .hd{display:grid;grid-template-columns:1fr auto;gap:2px 12px;padding:11px 14px;cursor:pointer;width:100%;align-items:center}\n.cxp .node .hd:hover{background:var(--panel-2)}\n.cxp .node .hd .t{font-weight:600;font-size:13.5px} .cxp .node .hd .c{color:var(--faint);font-size:12px;text-align:right}\n.cxp .dots{display:flex;gap:3px;flex-wrap:wrap;margin-top:6px} .cxp .dots i{width:7px;height:7px;border-radius:50%;display:block;background:var(--mint);opacity:.85}\n.cxp .dots i.ambre{background:var(--ambre)} .cxp .dots i.rouge{background:var(--rouge)} .cxp .dots i.gris{background:var(--gris);opacity:.5} .cxp .dots i.mauve{background:var(--mauve)}\n.cxp .node .hd .av{color:var(--ambre);font-size:12px;text-align:right} .cxp .node .hd .av.rouge{color:var(--rouge)} .cxp .node .hd .av.ok{color:var(--faint)}\n.cxp .node .rows{display:none;border-top:1px solid var(--line);padding:4px 6px 6px}\n.cxp .node.open .rows{display:block}\n.cxp .node.open{border-color:var(--line-2)}\n.cxp .row{display:grid;grid-template-columns:10px 1fr auto;gap:0 10px;align-items:center;padding:7px 8px;border-radius:6px;width:100%}\n.cxp .row:hover{background:var(--mint);color:var(--ink)} .cxp .row:hover *{color:var(--ink) !important}\n.cxp .row i{width:8px;height:8px;border-radius:50%;background:var(--mint);display:block} .cxp .row i.ambre{background:var(--ambre)} .cxp .row i.rouge{background:var(--rouge)} .cxp .row i.gris{background:var(--gris)} .cxp .row i.mauve{background:var(--mauve)}\n.cxp .row .nm{font-size:13px;font-weight:500;line-height:1.25} .cxp .row .mt{color:var(--muted);font-size:11.5px;margin-top:2px;grid-column:2}\n.cxp .row .st{font-size:11.5px;color:var(--muted);white-space:nowrap;grid-row:span 2;align-self:center} .cxp .row .st.ambre{color:var(--ambre)} .cxp .row .st.rouge{color:var(--rouge)} .cxp .row .st.mauve{color:var(--mauve)}\n.cxp .row.hide{display:none}\n.cxp .node.dim{opacity:.25} .cxp .node.lit{border-color:var(--mint)} .cxp .node.sel{box-shadow:0 0 0 1px var(--mint),0 0 18px rgba(74,222,128,.22);border-color:var(--mint)}\n.cxp .pump{border:1px solid var(--line-2);border-radius:10px;background:var(--panel);padding:16px 16px 14px;position:sticky;top:16px;cursor:pointer}\n.cxp .pump:hover{border-color:var(--mint)}\n.cxp .pump .t{font-size:16px;font-weight:650} .cxp .pump .d{color:var(--muted);font-size:12.5px;margin-top:2px}\n.cxp .pump .run{display:inline-block;margin-top:10px;padding:3px 9px;border:1px solid var(--mint);color:var(--mint);border-radius:5px;font-family:var(--mono);font-size:12px}\n.cxp .pump .st{margin-top:10px;padding-top:10px;border-top:1px solid var(--line);font-size:12.5px} .cxp .pump .st.ambre{color:var(--ambre)} .cxp .pump .st.rouge{color:var(--rouge)} .cxp .pump .st.mint{color:var(--mint)}\n.cxp .pump.lit{border-color:var(--mint);box-shadow:0 0 0 1px var(--mint),0 0 22px rgba(74,222,128,.25)}\n.cxp path.pipe{stroke:rgba(255,255,255,.16);stroke-width:2;fill:none}\n.cxp path.flow{stroke:var(--mint);stroke-width:2.5;fill:none;stroke-dasharray:6 7;animation:cxpflow .9s linear infinite}\n.cxp path.fuite{stroke:var(--rouge);stroke-width:2;fill:none;stroke-dasharray:5 6;opacity:.8}\n@keyframes cxpflow{to{stroke-dashoffset:-13}}\n@media (prefers-reduced-motion:reduce){.cxp path.flow{animation:none}}\n/* détail */\n.cxp .detail{display:none} .cxp .detail.on{display:block} .cxp .diagram.off,.cxp .cbar.off{display:none}\n.cxp .back{display:inline-flex;align-items:center;gap:8px;color:var(--muted);margin-bottom:14px;font-size:13px} .cxp .back:hover{color:var(--mint)}\n.cxp .dh{display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:18px}\n.cxp .dh h1{font-size:24px;font-weight:650;letter-spacing:-.02em;margin:0 0 2px} .cxp .dh .m{color:var(--muted)}\n.cxp .dh .state{margin-left:auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap}\n.cxp .pill{display:inline-flex;align-items:center;gap:7px;padding:4px 11px;border-radius:14px;border:1px solid;font-size:12px;font-weight:600}\n.cxp .pill i{width:7px;height:7px;border-radius:50%} .cxp .pill.mint{color:var(--mint);border-color:var(--mint)} .cxp .pill.mint i{background:var(--mint)}\n.cxp .pill.ambre{color:var(--ambre);border-color:var(--ambre)} .cxp .pill.ambre i{background:var(--ambre)} .cxp .pill.rouge{color:var(--rouge);border-color:var(--rouge)} .cxp .pill.rouge i{background:var(--rouge)}\n.cxp .pill.gris{color:var(--muted);border-color:var(--line-2)} .cxp .pill.gris i{background:var(--gris)} .cxp .pill.mauve{color:var(--mauve);border-color:var(--mauve)} .cxp .pill.mauve i{background:var(--mauve)}\n.cxp .dg{display:grid;grid-template-columns:1.1fr 1fr;gap:14px;align-items:start}\n.cxp .card{border:1px solid var(--line);border-radius:10px;background:var(--panel);padding:14px 16px;margin-bottom:14px}\n.cxp .card h3{margin:0 0 10px;font-size:12px;font-weight:600;color:var(--muted);letter-spacing:.03em;text-transform:uppercase}\n.cxp .kv{display:grid;grid-template-columns:150px 1fr;gap:7px 12px} .cxp .kv div:nth-child(odd){color:var(--muted)}\n.cxp .actions{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}\n.cxp .ctrl{display:grid;grid-template-columns:1fr auto 70px;gap:5px 12px;font-size:12.5px} .cxp .ctrl .n{color:var(--muted)} .cxp .ctrl .v{text-align:right}\n.cxp .ctrl .verdict{text-align:right;font-weight:600} .cxp .ctrl .verdict.ok{color:var(--mint)} .cxp .ctrl .verdict.ko{color:var(--ambre)} .cxp .ctrl .verdict.bloq{color:var(--rouge)}\n.cxp .chip{display:inline-block;padding:2px 8px;border-radius:5px;background:var(--panel-2);border:1px solid var(--line);margin:2px 4px 2px 0;font-size:12px;white-space:nowrap;cursor:pointer}\n.cxp .chip:hover{border-color:var(--mint);color:var(--mint)} .cxp .chip.rouge{color:var(--rouge);border-color:var(--rouge)} .cxp .chip.ambre{color:var(--ambre);border-color:var(--ambre)} .cxp .chip.mauve{color:var(--mauve);border-color:rgba(192,132,252,.5)}\n.cxp ul.list{list-style:none;margin:0;padding:0} .cxp ul.list li{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-top:1px solid var(--line);align-items:center} .cxp ul.list li:first-child{border-top:0}\n.cxp .tag{font-size:11px;padding:1px 6px;border:1px solid var(--line-2);border-radius:4px;color:var(--muted);white-space:nowrap;margin-left:4px}\n.cxp .tag.mint{color:var(--mint);border-color:var(--mint)} .cxp .tag.ambre{color:var(--ambre);border-color:var(--ambre)} .cxp .tag.rouge{color:var(--rouge);border-color:var(--rouge)} .cxp .tag.mauve{color:var(--mauve);border-color:var(--mauve)}\n.cxp .ref{margin-top:8px;padding:9px 12px;border-left:2px solid var(--mint);background:var(--panel-2);border-radius:0 6px 6px 0;font-size:12.5px}\n.cxp .ref.ecart{border-left-color:var(--rouge)} .cxp .ref.choix{border-left-color:var(--gris)} .cxp .ref.modele{border-left-color:var(--mauve)} .cxp .ref.introuvable{border-left-color:var(--ambre)}\n.cxp .ref .t{font-weight:600;margin-bottom:2px} .cxp .ref .x{color:var(--muted);font-style:italic;margin-top:2px}\n.cxp .rep .v{font-weight:600} .cxp .rep .v.mint{color:var(--mint)} .cxp .rep .v.ambre{color:var(--ambre)} .cxp .rep .v.gris{color:var(--muted)}\n.cxp .rep ul{margin:4px 0 0;padding-left:16px;color:var(--muted)} .cxp .rep .proof{margin-top:8px;padding:7px 10px;border-left:2px solid var(--mint);background:var(--panel-2)}\n.cxp .two{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:8px 0} .cxp .two .v{font-size:24px;font-weight:650;letter-spacing:-.02em} .cxp .two .ok .v{color:var(--mint)} .cxp .two .ko .v{color:var(--rouge)} .cxp .two .l{color:var(--muted);font-size:12px}\n/* journal */\n.cxp .jf{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}\n.cxp .jf button{padding:6px 11px;border:1px solid var(--line);border-radius:6px;color:var(--muted);font-size:12.5px} .cxp .jf button.on{border-color:var(--mint);color:var(--text);background:var(--mint-soft)}\n.cxp .jl{display:grid;grid-template-columns:140px 110px 1fr 130px 200px;gap:0 14px;align-items:center;padding:10px 12px;border-bottom:1px solid var(--line);font-size:13px;width:100%;text-align:left}\n.cxp .jl.h{color:var(--faint);font-size:11.5px;text-transform:uppercase;letter-spacing:.03em;border-bottom:1px solid var(--line-2)}\n.cxp button.jl:hover{background:var(--panel-2)}\n.cxp .jl .g{display:inline-flex;align-items:center;gap:7px} .cxp .jl .g i{width:7px;height:7px;border-radius:50%;background:var(--mint)} .cxp .jl .g i.ambre{background:var(--ambre)} .cxp .jl .g i.rouge{background:var(--rouge)} .cxp .jl .g i.mauve{background:var(--mauve)} .cxp .jl .g i.gris{background:var(--gris)}\n.cxp .jl .r{color:var(--muted)} .cxp .jl .r.rouge{color:var(--rouge)} .cxp .jl .r.ambre{color:var(--ambre)}\n.cxp button.jl.grp{width:100%} .cxp .jl.grp .chev{color:var(--faint);margin-left:4px}\n.cxp .jl.sub{background:var(--panel);border-bottom:1px solid var(--line-2);font-size:12.5px} .cxp .jl.sub .muted{opacity:.85}\n.cxp .jl .lienc{color:var(--text);text-decoration:underline;text-decoration-color:var(--line-3);text-underline-offset:2px} .cxp .jl .lienc:hover{text-decoration-color:var(--mint)}\n.cxp .jpage{display:flex;gap:10px;align-items:center;margin-top:12px;color:var(--muted);font-size:12.5px}\n.cxp .toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--panel);border:1px solid var(--mint);padding:10px 14px;border-radius:6px;z-index:30;max-width:90vw}\n/* DASHBOARD-4 D1 — bande des compteurs (= ceux des verrous) */\n.cxp .cc-strip{display:flex;flex-wrap:wrap;gap:6px;align-items:baseline;margin:10px 0 16px;padding:9px 12px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--muted);font-size:13px}\n.cxp .cc-strip b{color:var(--text);font-weight:650;font-variant-numeric:tabular-nums} .cxp .cc-strip .cc-sep{color:var(--faint)} .cxp .cc-strip .cc-plus{color:var(--faint)}\n/* DASHBOARD-4 D2 — bloc verrous joués à la demande */\n.cxp .verrous-bloc{margin:8px 0 20px} .cxp .verrous-tete{display:flex;align-items:center;gap:12px;margin:0 0 10px} .cxp .verrous-tete h2{font-size:15px;font-weight:600;flex:1}\n.cxp details.item{display:block;grid-template-columns:none} .cxp details.item>summary{cursor:pointer} .cxp details.item[open]>summary{margin-bottom:8px}\n.cxp .verrous-details{margin:0 0 2px 40px;padding:0 0 0 16px;list-style:disc;color:var(--muted);font-size:12px} .cxp .verrous-details li{margin:2px 0}\n/* DASHBOARD-4 D7 — plafond agents + crédit, dans l'onglet Circuit */\n.cxp .agents-info{margin:2px 0 14px;padding:9px 12px;border:1px solid var(--line);border-left:3px solid var(--mauve);border-radius:8px;background:var(--panel);color:var(--muted);font-size:13px}\n.cxp .agents-info.off{border-left-color:var(--faint)} .cxp .agents-info b{color:var(--text)} .cxp .agents-info a{color:var(--mint)}\n/* DASHBOARD-4b lot 2 — panneau « sens inverse » (élément → sources) */\n.cxp .sens-inverse{margin-bottom:14px}\n.cxp .si-input{width:100%;margin-top:8px;padding:9px 12px;border:1px solid var(--line-2);border-radius:8px;background:var(--panel-2);color:var(--text);font-size:13.5px}\n.cxp .si-list{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:10px}\n.cxp .si-list li{border-top:1px solid var(--line);padding-top:10px} .cxp .si-list li:first-child{border-top:0;padding-top:0}\n.cxp .si-el{font-size:13.5px;margin-bottom:5px} .cxp .si-el b{font-weight:650}\n.cxp .si-src{display:flex;flex-wrap:wrap;gap:6px}\n.cxp :focus-visible{outline:2px solid var(--jaune);outline-offset:2px}\n/* ══ CIRCUIT-P4 (lot 2) — onglet « À faire » ══ */\n.cxp .btn.ghost{border-color:transparent;color:var(--muted);font-weight:500}\n.cxp .btn.ghost:hover{background:var(--panel-2);color:var(--text);border-color:transparent}\n.cxp .af-head{display:flex;align-items:baseline;gap:12px;margin:4px 0 14px;flex-wrap:wrap}\n.cxp .af-head h1{font-size:26px;font-weight:650;letter-spacing:-.02em;margin:0}\n.cxp .af-head h1 b{color:var(--ambre);font-weight:650}\n.cxp .af-head .when{color:var(--muted);font-size:13px}\n.cxp .af-dates{color:var(--muted);font-size:12.5px;margin:0 0 16px} .cxp .af-dates span+span::before{content:\"·\";margin:0 8px;color:var(--faint)}\n.cxp .af-calm .lienc{color:var(--mint);text-decoration:underline;text-underline-offset:2px}\n.cxp .af-list{display:flex;flex-direction:column;gap:8px}\n.cxp .af-item{display:grid;grid-template-columns:12px 1fr auto;gap:14px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:14px 16px}\n.cxp .af-item.rouge{border-color:rgba(248,113,113,.35)}\n.cxp .af-item .dot{width:10px;height:10px;border-radius:50%;background:var(--ambre)}\n.cxp .af-item.rouge .dot{background:var(--rouge)} .cxp .af-item.mint .dot{background:var(--mint)} .cxp .af-item.gris .dot{background:var(--gris)}\n.cxp .af-item .t{font-weight:600;font-size:14px} .cxp .af-item .d{color:var(--muted);font-size:12.5px;margin-top:3px}\n.cxp .af-acts{display:flex;gap:8px;align-items:center}\n.cxp .af-calm{margin-top:22px;padding:14px 16px;border:1px dashed var(--line-2);border-radius:8px;color:var(--muted);font-size:13px}\n.cxp .af-calm b{color:var(--text);font-weight:600}\n.cxp .af-rules{margin-top:24px;color:var(--faint);font-size:12px}\n/* ══ CIRCUIT-P4 (lot 3) — onglet « Sources » ══ */\n.cxp .src-bar{display:flex;gap:10px;align-items:center;margin-bottom:12px;flex-wrap:wrap}\n.cxp .src-bar .search{flex:1;min-width:240px;background:var(--panel);border:1px solid var(--line-2);border-radius:6px;padding:8px 12px;color:var(--text);font:inherit}\n.cxp .src-bar .search::placeholder{color:var(--faint)}\n.cxp .seg{display:flex;border:1px solid var(--line-2);border-radius:6px;overflow:hidden}\n.cxp .seg button{padding:7px 12px;color:var(--muted);font-size:12.5px}\n.cxp .seg button.on{background:var(--mint);color:var(--ink);font-weight:600}\n.cxp .src-chips{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}\n.cxp .src-chips .chip{display:flex;gap:6px;align-items:center;border:1px solid var(--line-2);border-radius:16px;padding:4px 11px;font-size:12.5px;color:var(--muted);background:none}\n.cxp .src-chips .chip.on{color:var(--text)} .cxp .src-chips .chip i{width:8px;height:8px;border-radius:50%;display:inline-block}\n.cxp table.src{width:100%;border-collapse:collapse}\n.cxp table.src th{text-align:left;color:var(--faint);font-weight:500;font-size:11.5px;padding:6px 10px;border-bottom:1px solid var(--line)}\n.cxp table.src td{padding:10px 10px;border-bottom:1px solid var(--line);vertical-align:top}\n.cxp table.src tr.row{cursor:pointer} .cxp table.src tr.row:hover td{background:var(--panel-2)}\n.cxp table.src .nm{font-weight:500} .cxp table.src .fam{color:var(--faint);font-size:12px}\n.cxp table.src td.date{font-family:var(--mono);font-size:12px;white-space:nowrap}\n.cxp table.src td.date small{display:block;color:var(--faint);font-family:inherit;font-size:11.5px}\n.cxp table.src td.act{text-align:right;white-space:nowrap}\n.cxp .clock{color:var(--faint);font-size:11.5px;margin-left:6px}\n.cxp .src-why{color:var(--muted)} .cxp .src-foot{color:var(--faint);font-size:12px;margin-top:12px}\n.cxp .stt{display:inline-flex;align-items:center;gap:7px;white-space:nowrap}\n.cxp .stt i{width:9px;height:9px;border-radius:50%;display:inline-block;background:var(--gris)}\n.cxp .stt.mint i{background:var(--mint)} .cxp .stt.ambre i{background:var(--ambre)} .cxp .stt.rouge i{background:var(--rouge)} .cxp .stt.gris i{background:var(--gris)}\n.cxp .stt.ambre{color:var(--ambre)} .cxp .stt.rouge{color:var(--rouge)} .cxp .stt.gris{color:var(--muted)}\n/* ══ CIRCUIT-P7 (lot 1) — en-tête (titre + sous-titre), cartes Sonde/Agents, résultat du contrôle ══ */\n.cxp .cx-tete{display:flex;align-items:baseline;gap:14px;margin:2px 0 4px;flex-wrap:wrap}\n.cxp .cx-tete h1{font-size:26px;font-weight:700;letter-spacing:-.02em;margin:0}\n.cxp .cx-sous{color:var(--muted);font-size:14px}\n.cxp .tabs .n.neutre{color:var(--faint)} .cxp .tabs .on .n.neutre{color:var(--faint)}\n.cxp .controles{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:2px 0 18px}\n.cxp .carte{border:1px solid var(--line);border-radius:8px;background:var(--panel)}\n.cxp .controle{padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:16px;margin:0}\n.cxp .controle.agents{border-left:3px solid var(--mauve)}\n.cxp .controle .titre{font-weight:600;display:flex;align-items:center;gap:8px}\n.cxp .controle .desc{color:var(--muted);margin-top:4px;font-size:12.5px;line-height:1.5}\n.cxp .controle .desc b{color:var(--text)}\n.cxp .past{width:9px;height:9px;border-radius:50%;display:inline-block;flex:none;background:var(--gris)}\n.cxp .past.ok{background:var(--mint)} .cxp .past.mauve{background:var(--mauve)} .cxp .past.ambre{background:var(--ambre)} .cxp .past.rouge{background:var(--rouge)}\n.cxp .agents-cours{margin-top:10px;display:flex;align-items:center;gap:12px;color:var(--mauve);font-size:12.5px}\n.cxp .agents-cours .barre{flex:1;height:6px;border-radius:9999px;background:var(--line);overflow:hidden}\n.cxp .agents-cours .barre i{display:block;height:100%;background:var(--mauve);transition:width .4s linear}\n.cxp .menu{position:relative;flex:none}\n.cxp .menu-liste{position:absolute;right:0;top:38px;z-index:5;min-width:280px;background:var(--panel-2);border:1px solid var(--line-2);border-radius:6px;padding:6px}\n.cxp .menu-liste button{display:block;width:100%;text-align:left;padding:8px 10px;border-radius:6px;color:var(--text)}\n.cxp .menu-liste button:hover:not([disabled]){background:var(--mauve);color:var(--ink)}\n.cxp .menu-liste button:hover:not([disabled]) .muted{color:var(--ink)}\n.cxp .menu-liste button[disabled]{cursor:default} .cxp .menu-liste .sep{border-top:1px solid var(--line);margin:6px 0}\n.cxp .menu-liste.confirm{min-width:320px;padding:12px}\n.cxp .menu-liste.confirm .cf-txt{font-size:12.5px;color:var(--muted);line-height:1.5} .cxp .menu-liste.confirm .cf-txt b{color:var(--text)}\n.cxp .menu-liste.confirm .cf-acts{display:flex;gap:8px;justify-content:flex-end;margin-top:12px}\n.cxp .cx-verif{margin-bottom:16px}\n.cxp .cx-verif-res{margin-top:10px;font-size:13px;line-height:1.6} .cxp .cx-verif-res b{color:var(--text);font-weight:600} .cxp .cx-verif-res b.r{color:var(--rouge)}\n.cxp .cx-verif-res .lienc{color:var(--mint);text-decoration:underline;text-underline-offset:2px}\n/* ══ CIRCUIT-P7 (lot 2) — tableau Sources à colonnes fixes (nom jamais tronqué, deux lignes) ══ */\n.cxp .svt{margin-top:16px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--panel)}\n.cxp .svt-h,.cxp .svt-r{display:grid;grid-template-columns:minmax(0,1fr) 168px 168px 164px 148px 116px;gap:14px;align-items:center;padding:10px 16px}\n.cxp .svt-h{height:36px;padding-top:0;padding-bottom:0;color:var(--faint);font-size:11.5px;text-transform:uppercase;letter-spacing:.03em;border-bottom:1px solid var(--line);background:var(--panel-2)}\n.cxp .svt-r{min-height:56px;border-bottom:1px solid var(--line);cursor:pointer}\n.cxp .svt-r:last-of-type{border-bottom:0} .cxp .svt-r:hover{background:var(--panel-2)}\n.cxp .svt-nm{display:flex;gap:10px;align-items:flex-start;min-width:0}\n.cxp .svt-nm .dot{width:9px;height:9px;border-radius:50%;flex:none;margin-top:5px;background:var(--gris)}\n.cxp .svt-nm .dot.mint{background:var(--mint)} .cxp .svt-nm .dot.ambre{background:var(--ambre)} .cxp .svt-nm .dot.rouge{background:var(--rouge)} .cxp .svt-nm .dot.gris{background:var(--gris)}\n.cxp .svt-nm .nm{font-weight:600;line-height:1.25;overflow-wrap:anywhere}\n.cxp .svt-nm .fam{color:var(--faint);font-size:11.5px;margin-top:2px;overflow-wrap:anywhere}\n.cxp .svt-nm .clock{color:var(--faint)}\n.cxp .svt-r .cel{display:flex;flex-direction:column;font-size:12.5px;min-width:0;overflow-wrap:anywhere}\n.cxp .svt-r .cel small{color:var(--faint);font-size:11.5px} .cxp .svt-r .cel.vide{color:var(--faint)}\n.cxp .svt-r .act{text-align:right} .cxp .svt-r .act .btn{padding:5px 10px;font-size:12px}\n.cxp .svt-foot{padding:12px 16px;color:var(--faint);font-size:12px;border-top:1px solid var(--line)}\n/* ══ CIRCUIT-P7 (lot 3) — légende une ligne + interrupteur « ce qui cloche », recherche unique ══ */\n.cxp .clegend{display:flex;gap:16px;align-items:center;margin:0 0 16px;color:var(--faint);font-size:12px;flex-wrap:wrap}\n.cxp .clegend>span{display:inline-flex;align-items:center}\n.cxp .clegend i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px}\n.cxp .clegend .sw{margin-left:auto}\n.cxp .si-results{margin-bottom:14px}\n.cxp .node.masque{display:none}\n@media (max-width:1100px){ .cxp .diagram{grid-template-columns:1fr;column-gap:0} .cxp .diagram svg{display:none} .cxp .pump{position:static;margin:12px 0} .cxp .dg{grid-template-columns:1fr} .cxp .kpis{grid-template-columns:1fr 1fr} .cxp .jl{grid-template-columns:1fr 1fr} .cxp .controles{grid-template-columns:1fr} }\n`;function yg(e){return e.type===`pompe`?{kind:`detail`,type:`pompe`,id:`pompe`}:e.type===`compteur`?{kind:`detail`,type:`compteur`,id:`compteur`}:e.ids.length===1?{kind:`detail`,type:e.type,id:e.ids[0]}:{kind:`groupe`,type:e.type,ids:e.ids}}var bg=e=>e?new Date(e).toLocaleString(`fr-FR`,{day:`2-digit`,month:`2-digit`,hour:`2-digit`,minute:`2-digit`}):`—`;function xg(){let e=S(),t=b({queryKey:[`admin-circuit`],queryFn:li,refetchInterval:6e4}),[n,r]=(0,M.useState)(`todo`),[i,a]=(0,M.useState)(null),[o,c]=(0,M.useState)(null),[l,u]=(0,M.useState)(null),[d,f]=(0,M.useState)(null),[p,m]=(0,M.useState)(null),[h,g]=(0,M.useState)(null),_=b({queryKey:[`circuit-taches`],queryFn:pi,refetchInterval:e=>{let t=e.state.data;return t&&(t.verifier?.etat===`en_cours`||t.agents?.etat===`en_cours`||t.verrous?.etat===`en_cours`||t.sonde?.etat===`en_cours`)?1500:!1}}),v=_.data?.verifier,y=_.data?.agents,x=_.data?.sonde,C=_.data?.verrous,w=b({queryKey:[`sources-par-element`],queryFn:Wt,staleTime:3e5}).data?.elements??[],T=s({mutationFn:ui,onSuccess:()=>{m(null),g(null),_.refetch()}}),E=s({mutationFn:()=>fi(),o