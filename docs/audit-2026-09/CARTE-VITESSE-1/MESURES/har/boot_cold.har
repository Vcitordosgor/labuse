on{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0;text-align:left}\n.cxp code{font-family:var(--mono);font-size:12px}\n.cxp .muted{color:var(--muted)} .cxp .faint{color:var(--faint)}\n/* onglets + boutons */\n.cxp .tabs{display:flex;align-items:center;gap:2px;border-bottom:1px solid var(--line);margin-bottom:18px}\n.cxp .tabs button{padding:12px 16px;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px;font-weight:500;font-size:13.5px}\n.cxp .tabs button.on{color:var(--text);border-bottom-color:var(--mint)}\n.cxp .tabs button:not(.on):hover{color:var(--text)}\n.cxp .tabs .n{color:var(--faint);font-weight:400;margin-left:6px}\n.cxp .tabs .on .n{color:var(--ambre)}\n.cxp .tabs .actions{margin-left:auto;display:flex;gap:8px;padding:7px 0}\n.cxp .btn{padding:7px 13px;border:1px solid var(--line-2);color:var(--text);border-radius:6px;font-weight:600;font-size:12.5px;white-space:nowrap}\n.cxp .btn:hover{background:var(--mint);border-color:var(--mint);color:var(--ink)}\n.cxp .btn.mint{border-color:var(--mint);color:var(--mint)} .cxp .btn.mint:hover{background:var(--mint);color:var(--ink)}\n.cxp .btn.mauve{border-color:var(--mauve);color:var(--mauve)} .cxp .btn.mauve:hover{background:var(--mauve);color:var(--ink)}\n.cxp .btn.ambre{border-color:var(--ambre);color:var(--ambre)} .cxp .btn.ambre:hover{background:var(--ambre);color:var(--ink)}\n.cxp .btn[disabled]{opacity:.35;pointer-events:none}\n.cxp .tab{display:none} .cxp .tab.on{display:block}\n/* résumé */\n.cxp .res{max-width:1000px}\n.cxp .res h1{font-size:28px;font-weight:650;letter-spacing:-.02em;margin:4px 0 4px} .cxp .res h1 b{color:var(--ambre);font-weight:650}\n.cxp .res .sub{color:var(--muted);margin-bottom:18px;font-size:14px}\n.cxp .tbar{display:flex;align-items:center;gap:12px;margin:-6px 0 16px;padding:9px 13px;border-radius:8px;font-size:12.5px;border:1px solid var(--line);background:var(--panel)}\n.cxp .tbar.run{border-color:var(--mint);color:var(--text)} .cxp .tbar.ok{border-color:var(--mint);color:var(--text)} .cxp .tbar.echec{border-color:var(--rouge);color:var(--text)} .cxp .tbar.info{border-color:var(--ambre);color:var(--text)}\n.cxp .tbar .pct{flex:0 0 120px;height:6px;border-radius:3px;background:var(--line);overflow:hidden} .cxp .tbar .pct i{display:block;height:100%;background:var(--mint)}\n.cxp .tbar .tx{flex:1} .cxp .tbar .x{flex:0 0 auto;color:var(--muted);font-size:13px;padding:0 4px} .cxp .tbar .x:hover{color:var(--text)}\n.cxp .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:0 0 26px}\n.cxp .kpi{padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:var(--panel)}\n.cxp .kpi .v{font-size:20px;font-weight:650;letter-spacing:-.02em} .cxp .kpi .v small{font-size:13px;color:var(--muted);font-weight:500;margin-left:4px}\n.cxp .kpi .l{color:var(--muted);font-size:12px;margin-top:2px}\n.cxp button.kpi.lien{display:block;width:100%;transition:border-color .12s} .cxp button.kpi.lien:hover{border-color:var(--mint)} .cxp button.kpi.lien:hover .l{color:var(--text)}\n.cxp .sect{display:flex;align-items:baseline;gap:10px;margin:24px 0 8px}\n.cxp .sect h2{margin:0;font-size:13px;font-weight:600;color:var(--text)} .cxp .sect span{color:var(--faint);font-size:12px}\n.cxp .item{display:grid;grid-template-columns:44px 1fr auto;gap:0 14px;align-items:center;padding:12px 14px 12px 12px;border:1px solid var(--line);border-radius:8px;background:var(--panel);margin-bottom:6px;width:100%}\n.cxp .item:hover{border-color:var(--line-2);background:var(--panel-2)}\n.cxp .item .num{font-size:18px;font-weight:650;letter-spacing:-.02em;text-align:center;padding:4px 0;border-radius:6px;background:var(--panel-2)}\n.cxp .item.rouge .num{color:var(--rouge)} .cxp .item.ambre .num{color:var(--ambre)} .cxp .item.gris .num{color:var(--muted)} .cxp .item.mint .num{color:var(--mint)} .cxp .item.mauve .num{color:var(--mauve)}\n.cxp .item .t{font-weight:600;font-size:14px;display:block} .cxp .item .d{color: