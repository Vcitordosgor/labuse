ende\":\"N — naturelle\"},{\"id\":\"aut\",\"propriete\":\"zone_fam\",\"valeur\":\"autre\",\"couleur\":\"#8A94A6\",\"legende\":\"Autre zonage\"}],\"popup\":[{\"champ\":\"zone_lib\",\"libelle\":\"Zone\"},{\"champ\":\"commune\",\"libelle\":\"Commune\"}],\"legende\":\"Zonage PLU par parcelle — famille U/AU/A/N (calibré)\",\"i\":\"Zone du PLU CALIBRÉE parcelle par parcelle (famille U urbaine / AU à urbaniser / A agricole / N naturelle). L'étiquette de zone (Ncu, U1b…) apparaît dès le zoom commune.\",\"centroide\":false,\"groupe\":null,\"etiquette\":{\"propriete\":\"zone_lib\",\"zoom_min\":12},\"statut_juridique\":null,\"tuiles_url\":\"/map/tiles/zonage_parcelle/{z}/{x}/{y}.pbf\"},{\"kind\":\"plu_gpu_zone\",\"nom\":\"Limites officielles du PLU (GPU)\",\"famille\":\"urbanisme\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":1,\"style\":{\"couleur_propriete\":\"subtype\",\"couleurs\":{\"U\":\"#5CE6A1\"},\"couleur\":\"#8a6b3f\",\"opacite\":0.1,\"trait\":\"#8a6b3f\"},\"niveaux\":null,\"popup\":null,\"legende\":\"Limites PLU (GPU) — U (vert) / A·AU·N (brun)\",\"i\":\"Zones du PLU telles que publiées au Géoportail de l'Urbanisme (GPU). Deux teintes : U (urbaine, en vert) / le reste A·AU·N (brun). Pour l'étiquette de zone parcelle par parcelle, voir « Zonage PLU par parcelle (calibré) ».\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":\"opposable\",\"tuiles_url\":\"/map/tiles/plu_gpu_zone/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"cinquante_pas\",\"nom\":\"50 pas géométriques\",\"famille\":\"urbanisme\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":20,\"style\":{\"couleur\":\"#1E9BD8\",\"opacite\":0.34,\"trait\":\"#0B6FA6\",\"tirets\":[2,1.4],\"epaisseur\":1.8},\"niveaux\":null,\"popup\":null,\"legende\":\"Réserve des 50 pas géométriques (littoral)\",\"i\":\"Réserve des 50 pas géométriques (bande littorale du domaine public, ~81,20 m) — inconstructibilité de principe, gestion État.\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":null,\"tuiles_url\":\"/map/tiles/cinquante_pas/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"artificialisation\",\"nom\":\"Artificialisation (OCS GE)\",\"famille\":\"urbanisme\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":22,\"style\":{\"couleur_propriete\":\"subtype\",\"couleurs\":{\"artificialise_2022\":\"#8E6AA8\",\"evolution_renaturation\":\"#3F9B6A\"},\"couleur\":\"#8E6AA8\",\"opacite\":0.32,\"trait\":\"#5E4470\"},\"niveaux\":null,\"popup\":null,\"legende\":\"Artificialisé 2022 (violine) / renaturé (vert)\",\"i\":\"Occupation du sol OCS GE : sols artificialisés 2022 + évolution renaturée 2017→2022 (matrice décret 2023-1096, suivi ZAN).\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup_detail\":null,\"statut_juridique\":null,\"tuiles_url\":\"/map/tiles/artificialisation/{z}/{x}/{y}.pbf\",\"subdivise\":true},{\"kind\":\"dpu\",\"nom\":\"Droit de préemption urbain (DPU)\",\"famille\":\"urbanisme\",\"geometrie\":\"polygone\",\"zoom_min\":0,\"rang_carte\":24,\"style\":{\"couleur_propriete\":\"subtype\",\"couleur\":\"#6B8FD4\",\"opacite\":0.32,\"trait\":\"#33507f\"},\"niveaux\":[{\"id\":\"simple\",\"propriete\":\"subtype\",\"valeur\":\"dpu\",\"couleur\":\"#6B8FD4\",\"legende\":\"DPU simple\"},{\"id\":\"renforce\",\"propriete\":\"subtype\",\"valeur\":\"dpu_renforce\",\"couleur\":\"#E0574A\",\"legende\":\"DPU renforcé\"}],\"popup\":[{\"champ\":\"libelle\",\"libelle\":\"Type\"},{\"champ\":\"txt\",\"libelle\":\"Précision\"}],\"legende\":\"Périmètre DPU — simple (bleu) / renforcé (rouge)\",\"i\":\"Périmètres de DPU (simple / renforcé) — la commune peut se substituer à l'acquéreur lors d'une vente.\",\"centroide\":false,\"groupe\":null,\"etiquette\":null,\"icones\":null,\"note\":null,\"detail_kind\":null,\"popup